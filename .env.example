# DonationAlerts OAuth application credentials
APP_ID=
CLIENT_SECRET=
# DonationAlerts user id; the donation channel is $alerts:donation_<USER_ID>
USER_ID=

# Must exactly match the redirect URI registered for the app
REDIRECT_URI=https://gunlinux.ru/callback/

# Space-separated OAuth scopes requested by `login` (quote values with spaces)
SCOPES="oauth-user-show oauth-donation-subscribe oauth-donation-index"

# Filled automatically by `donationalerts token <CODE>`
ACCESS_TOKEN=

# Note: the OAuth refresh token is NOT stored here. It lives in `.tokens.json`
# (gitignored, mode 0600), written by `token` and rotated by `refresh`.
